---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import membership from '../../content/pages/en/membership.json';
const flow = membership.signupFlow;
---

<BaseLayout title="Membership | Pugliesi nel Mondo UK" currentPath="/en/membership" lang="en">
  <div class="page-layout" style="max-width: 900px;">
    <h1>{membership.title}</h1>
    <p class="intro">{membership.intro}</p>

    <div class="pricing-grid" style="grid-template-columns: repeat(2, 1fr); max-width: 700px; margin: 2rem auto;">
      {membership.plans.map((plan, index) => (
        <div class={`pricing-card ${plan.highlight ? 'pricing-featured' : ''}`}>
          {plan.highlight && <div class="pricing-badge">Individual</div>}
          {!plan.highlight && <div class="pricing-badge" style="background: var(--color-gold);">Business</div>}
          <h3 class="pricing-name">{plan.name}</h3>
          {plan.label && <p style="color: var(--color-gold); font-weight: 600; font-size: 0.85rem; margin-bottom: 0.5rem;">{plan.label}</p>}
          <p class="pricing-desc">{plan.description}</p>
          <div class="pricing-price">
            <span class="pricing-currency">&pound;</span>
            <span class="pricing-amount">{plan.price}</span>
            <span class="pricing-period">/year</span>
          </div>
          {plan.priceNote && <p style="font-size: 0.8rem; color: var(--color-gray); margin-top: -1rem; margin-bottom: 1rem;">({plan.priceNote})</p>}
          <ul class="pricing-features">
            {plan.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
          <button
            class={`signup-trigger ${plan.highlight ? 'btn-primary' : 'btn-outline'}`}
            style="width: 100%; text-align: center; cursor: pointer; border: none;"
            data-plan-name={plan.name}
            data-plan-price={plan.price}
            data-plan-index={index}
          >
            Join
          </button>
        </div>
      ))}
    </div>

    <!-- Multi-step Signup Form -->
    <div id="signup-modal" class="signup-overlay" style="display: none;">
      <div class="signup-panel">
        <button class="signup-close" id="signup-close" aria-label="Close">&times;</button>

        <!-- Progress Bar (2 steps) -->
        <div class="signup-progress">
          <div class="signup-step active" data-step="1">
            <div class="step-circle">1</div>
            <span class="step-label">{flow.step1Title}</span>
          </div>
          <div class="signup-step-line"></div>
          <div class="signup-step" data-step="2">
            <div class="step-circle">2</div>
            <span class="step-label">{flow.step2Title}</span>
          </div>
        </div>

        <h2 class="signup-plan-title" id="signup-plan-title"></h2>

        <!-- Step 1: Personal Data -->
        <div class="signup-step-content active" id="step-1">
          <div class="signup-form-grid">
            <div class="form-group">
              <label for="signup-fname">{flow.firstNameLabel} *</label>
              <input type="text" id="signup-fname" required />
            </div>
            <div class="form-group">
              <label for="signup-lname">{flow.lastNameLabel} *</label>
              <input type="text" id="signup-lname" required />
            </div>
            <div class="form-group">
              <label for="signup-email">{flow.emailLabel} *</label>
              <input type="email" id="signup-email" required />
            </div>
            <div class="form-group">
              <label for="signup-phone">{flow.phoneLabel}</label>
              <input type="tel" id="signup-phone" />
            </div>
            <div class="form-group form-group-full">
              <label for="signup-birthplace">{flow.birthPlaceLabel} *</label>
              <input type="text" id="signup-birthplace" required />
            </div>
            <div class="form-group form-group-full" id="business-field" style="display: none;">
              <label for="signup-business">{flow.businessLabel}</label>
              <input type="text" id="signup-business" />
            </div>
            <div class="form-group form-group-full signup-checkbox-group">
              <label class="signup-checkbox-label">
                <input type="checkbox" id="signup-uk-resident" />
                <span>{flow.ukResidentLabel}</span>
              </label>
            </div>
          </div>
          <p class="signup-privacy">{flow.privacyNote}</p>
          <div class="signup-actions">
            <button class="btn-primary" id="btn-next-1">{flow.nextButton} &rarr;</button>
          </div>
        </div>

        <!-- Step 2: Summary & Send -->
        <div class="signup-step-content" id="step-2">
          <h3 style="margin-bottom: 1.5rem; color: var(--color-primary);">{flow.summaryTitle}</h3>
          <div class="summary-card">
            <div class="summary-row">
              <span>{flow.planLabel}</span>
              <strong id="summary-plan"></strong>
            </div>
            <div class="summary-row">
              <span>{flow.amountLabel}</span>
              <strong id="summary-amount"></strong>
            </div>
            <div class="summary-row">
              <span>{flow.firstNameLabel}</span>
              <strong id="summary-fname"></strong>
            </div>
            <div class="summary-row">
              <span>{flow.lastNameLabel}</span>
              <strong id="summary-lname"></strong>
            </div>
            <div class="summary-row">
              <span>{flow.emailLabel}</span>
              <strong id="summary-email"></strong>
            </div>
            <div class="summary-row" id="summary-phone-row">
              <span>{flow.phoneLabel}</span>
              <strong id="summary-phone"></strong>
            </div>
            <div class="summary-row">
              <span>{flow.birthPlaceLabel}</span>
              <strong id="summary-birthplace"></strong>
            </div>
            <div class="summary-row" id="summary-uk-row">
              <span>UK Resident</span>
              <strong id="summary-uk-resident"></strong>
            </div>
            <div class="summary-row" id="summary-business-row" style="display: none;">
              <span>{flow.businessLabel}</span>
              <strong id="summary-business"></strong>
            </div>
          </div>
          <p class="signup-privacy" style="margin-top: 1rem;">{flow.privacyNote}</p>
          <div class="signup-actions">
            <button class="btn-outline" id="btn-back-2">&larr; {flow.backButton}</button>
            <button class="btn-primary" id="btn-send" style="text-align: center;">{flow.sendButton}</button>
          </div>
        </div>

        <!-- Success message -->
        <div class="signup-step-content" id="step-success" style="text-align: center; padding: 2rem 0;">
          <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--color-primary);">&#10003;</div>
          <h3 style="color: var(--color-primary); margin-bottom: 1rem;">{flow.successTitle}</h3>
          <p style="color: var(--color-dark); line-height: 1.6;">{flow.successMessage}</p>
          <button class="btn-primary" id="btn-close-success" style="margin-top: 2rem;">Close</button>
        </div>

        <!-- Error message -->
        <div class="signup-step-content" id="step-error" style="text-align: center; padding: 2rem 0;">
          <div style="font-size: 3rem; margin-bottom: 1rem;">&#9888;</div>
          <h3 style="color: #c0392b; margin-bottom: 1rem;">Error</h3>
          <p style="color: var(--color-dark); line-height: 1.6;">{flow.errorMessage}</p>
          <div class="signup-actions" style="justify-content: center;">
            <button class="btn-outline" id="btn-retry">&larr; Try again</button>
          </div>
        </div>
      </div>
    </div>

    <div style="margin-top: 4rem;">
      <h2 class="section-title">Benefits for All Members</h2>
      <ul class="benefits-list">
        {membership.benefits.map((benefit) => (
          <li>{benefit}</li>
        ))}
      </ul>
    </div>

    <div style="text-align: center; margin-top: 3rem; padding: 2.5rem; background: var(--color-cream); border-radius: 8px;">
      <p style="font-size: 1.1rem; margin-bottom: 1rem; color: var(--color-dark);">Questions about membership?</p>
      <a href={`mailto:${membership.contact.email}`} class="btn-secondary">{membership.contact.email}</a>
      <p style="margin-top: 0.8rem; color: var(--color-gray);">Tel: {membership.contact.phone}</p>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ sendingText: flow.sendingButton, sendText: flow.sendButton }}>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('signup-modal');
    const closeBtn = document.getElementById('signup-close');
    const triggers = document.querySelectorAll('.signup-trigger');
    const allStepContents = document.querySelectorAll('.signup-step-content');
    const progressSteps = document.querySelectorAll('.signup-progress .signup-step');
    const progressLines = document.querySelectorAll('.signup-step-line');

    let selectedPlan = '';
    let selectedPrice = 0;
    let isAWR = false;

    triggers.forEach(btn => {
      btn.addEventListener('click', () => {
        selectedPlan = btn.dataset.planName;
        selectedPrice = btn.dataset.planPrice;
        isAWR = parseInt(btn.dataset.planIndex) === 1;

        document.getElementById('signup-plan-title').textContent = selectedPlan + ' — \u00A3' + selectedPrice + '/year';

        const businessField = document.getElementById('business-field');
        businessField.style.display = isAWR ? 'block' : 'none';

        document.querySelector('.signup-progress').style.display = '';
        document.getElementById('signup-plan-title').style.display = '';

        showStep('step-1');
        updateProgress(1);
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      });
    });

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.getElementById('btn-close-success').addEventListener('click', closeModal);

    function closeModal() {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    function showStep(stepId) {
      allStepContents.forEach(s => s.classList.remove('active'));
      document.getElementById(stepId).classList.add('active');
    }

    function updateProgress(step) {
      progressSteps.forEach((ps, i) => {
        ps.classList.toggle('active', i + 1 <= step);
      });
      progressLines.forEach((line, i) => {
        line.classList.toggle('active', i + 1 < step);
      });
    }

    document.getElementById('btn-next-1').addEventListener('click', () => {
      const fname = document.getElementById('signup-fname').value.trim();
      const lname = document.getElementById('signup-lname').value.trim();
      const email = document.getElementById('signup-email').value.trim();
      const birthplace = document.getElementById('signup-birthplace').value.trim();

      if (!fname || !lname || !email || !birthplace) {
        alert('Please fill in the required fields (First name, Last name, Email, Place of birth).');
        return;
      }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        alert('Please enter a valid email address.');
        return;
      }

      document.getElementById('summary-plan').textContent = selectedPlan;
      document.getElementById('summary-amount').textContent = '\u00A3' + selectedPrice + '/year';
      document.getElementById('summary-fname').textContent = fname;
      document.getElementById('summary-lname').textContent = lname;
      document.getElementById('summary-email').textContent = email;

      const phone = document.getElementById('signup-phone').value;
      if (phone) {
        document.getElementById('summary-phone').textContent = phone;
        document.getElementById('summary-phone-row').style.display = '';
      } else {
        document.getElementById('summary-phone-row').style.display = 'none';
      }

      document.getElementById('summary-birthplace').textContent = birthplace;

      const ukResident = document.getElementById('signup-uk-resident').checked;
      document.getElementById('summary-uk-resident').textContent = ukResident ? 'Yes' : 'No';

      if (isAWR) {
        const biz = document.getElementById('signup-business').value;
        document.getElementById('summary-business').textContent = biz;
        document.getElementById('summary-business-row').style.display = '';
      }

      showStep('step-2');
      updateProgress(2);
    });

    document.getElementById('btn-back-2').addEventListener('click', () => {
      showStep('step-1');
      updateProgress(1);
    });

    document.getElementById('btn-retry').addEventListener('click', () => {
      showStep('step-2');
      updateProgress(2);
    });

    document.getElementById('btn-send').addEventListener('click', async () => {
      const btnSend = document.getElementById('btn-send');
      btnSend.disabled = true;
      btnSend.textContent = sendingText;

      const formData = {
        fname: document.getElementById('signup-fname').value.trim(),
        lname: document.getElementById('signup-lname').value.trim(),
        email: document.getElementById('signup-email').value.trim(),
        phone: document.getElementById('signup-phone').value.trim(),
        birthplace: document.getElementById('signup-birthplace').value.trim(),
        ukResident: document.getElementById('signup-uk-resident').checked,
        plan: selectedPlan,
        business: isAWR ? document.getElementById('signup-business').value.trim() : '',
        lang: 'en',
      };

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData),
        });

        if (response.ok) {
          document.querySelector('.signup-progress').style.display = 'none';
          document.getElementById('signup-plan-title').style.display = 'none';
          showStep('step-success');
        } else {
          showStep('step-error');
        }
      } catch (err) {
        console.error('Submit error:', err);
        showStep('step-error');
      } finally {
        btnSend.disabled = false;
        btnSend.textContent = sendText;
      }
    });
  });
</script>
