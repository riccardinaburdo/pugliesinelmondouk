---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const festivalPath = path.join(process.cwd(), 'src/content/events/puglian-italian-fest.json');
  const festival = JSON.parse(fs.readFileSync(festivalPath, 'utf-8'));
  return festival.programme.map((item: any) => ({
    params: { event: item.slug },
    props: { item, festival }
  }));
}

const { item, festival } = Astro.props;

// Build calendar URLs
const startDate = item.date.replace(/-/g, '');
const startTime = item.time && item.time !== 'TBA' && !item.time.includes('TBC')
  ? item.time.split(' - ')[0].replace(':', '') + '00'
  : '180000';
const endTime = item.time && item.time.includes(' - ')
  ? item.time.split(' - ')[1].replace(':', '') + '00'
  : String(Number(startTime.slice(0, 2)) + 2).padStart(2, '0') + startTime.slice(2);
const calStart = `${startDate}T${startTime}`;
const calEnd = `${startDate}T${endTime}`;
const calTitle = encodeURIComponent(item.title);
const calLocation = encodeURIComponent(`${item.venue}${item.address ? ', ' + item.address : ''}`);
const calDescription = encodeURIComponent(`${item.description}\n\nPuglian Italian Fest - pugliesinelmondouk.vercel.app`);

const googleCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${calTitle}&dates=${calStart}/${calEnd}&location=${calLocation}&details=${calDescription}`;
const outlookUrl = `https://outlook.live.com/calendar/0/action/compose?subject=${calTitle}&startdt=${item.date}T${startTime.slice(0,4)}&location=${calLocation}&body=${calDescription}`;
---

<BaseLayout title={`${item.title} | Puglian Italian Fest`} currentPath={`/eventi/puglian-italian-fest/${item.slug}`}>
  <div class="event-detail">
    <a href="/eventi/puglian-italian-fest" style="color: var(--color-primary); display: inline-block; margin-bottom: 2rem;">&larr; Torna al Programma</a>

    <!-- Hero image -->
    <div class="event-hero">
      {item.image ? <img src={item.image} alt={item.title} /> : <div class="event-hero-placeholder"></div>}
    </div>

    <!-- Title and category -->
    <h1>{item.title}</h1>
    {item.category && <span class="event-category-badge">{item.category}</span>}

    <!-- Event metadata -->
    <div class="event-info-block">
      <div class="event-info-row">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
        <div>
          <strong>Quando</strong>
          <p>{new Date(item.date).toLocaleDateString('it-IT', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}{item.time && item.time !== 'TBA' ? `, ${item.time}` : ''}</p>
        </div>
      </div>
      <div class="event-info-row">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" /></svg>
        <div>
          <strong>Dove</strong>
          <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.venue + (item.address ? ', ' + item.address : ''))}`} target="_blank" rel="noopener" class="event-venue-link">{item.venue}</a>
          {item.address && <p class="event-address"><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.venue + ', ' + item.address)}`} target="_blank" rel="noopener" class="event-venue-link">{item.address}</a></p>}
        </div>
      </div>
      {item.price && (
        <div class="event-info-row">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5"><text x="4" y="20" font-size="20" font-weight="bold" fill="var(--color-primary)" stroke="none">£</text></svg>
          <div>
            <strong>Prezzo</strong>
            <p>{item.price}</p>
          </div>
        </div>
      )}
    </div>

    <!-- Description -->
    <div class="event-description">
      {item.longDescription && item.longDescription.map((p: string) => <p>{p}</p>)}
      {!item.longDescription && <p>{item.description}</p>}
    </div>

    <!-- Booking -->
    <div class="event-booking">
      {item.bookingLink && (
        <a href={item.bookingLink} class="btn-primary booking-btn" data-booking-url={item.bookingLink}>
          Prenota Ora
        </a>
      )}
      {item.memberNote && (
        <button class="btn-member-free" id="memberNoteBtn">
          Gratis per i Soci
        </button>
      )}
    </div>

    <!-- Member Note Modal -->
    {item.memberNote && (
      <div class="member-modal-overlay" id="memberModal">
        <div class="member-modal">
          <button class="member-modal-close" id="memberModalClose">&times;</button>
          <h3>🎟️ Ingresso gratuito per i Soci</h3>
          <p>{item.memberNote}</p>
          <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:1rem;">
            {item.bookingLink && <a href={item.bookingLink} target="_blank" rel="noopener" class="btn-primary" style="font-size:0.9rem;">Prenota il tuo biglietto</a>}
            <a href="/diventa-socio" class="btn-secondary" style="font-size:0.9rem;">Diventa Socio</a>
          </div>
        </div>
      </div>
    )}

    <!-- Booking Modal -->
    <div class="booking-modal-overlay" id="bookingModal">
      <div class="booking-modal">
        <button class="booking-modal-close" id="bookingModalClose">&times;</button>
        <h3>Resta aggiornato</h3>
        <p class="booking-modal-desc">Lasciaci i tuoi dati per ricevere aggiornamenti su questo evento e sulle nostre attivita'. Saremo molto discreti: solo comunicazioni utili, niente spam. Potrai disiscriverti in qualsiasi momento con un solo click.</p>
        <form class="booking-modal-form" id="bookingForm">
          <input type="text" name="FNAME" placeholder="Nome" required />
          <input type="text" name="LNAME" placeholder="Cognome" required />
          <input type="email" name="EMAIL" placeholder="Email" required />
          <button type="submit" class="btn-primary" style="width: 100%;">Continua con la prenotazione</button>
        </form>
      </div>
    </div>

    <!-- Add to Calendar -->
    <div class="event-calendar">
      <h3>Aggiungi al Calendario</h3>
      <div class="calendar-buttons">
        <a href={googleCalUrl} target="_blank" rel="noopener" class="calendar-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
          Google Calendar
        </a>
        <a href={outlookUrl} target="_blank" rel="noopener" class="calendar-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
          Outlook
        </a>
        <a href="#" class="calendar-btn" id="ics-download" data-title={item.title} data-date={calStart} data-end={calEnd} data-location={`${item.venue}${item.address ? ', ' + item.address : ''}`} data-description={item.description}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
          Scarica .ics
        </a>
      </div>
    </div>

    <!-- Part of festival banner -->
    <div class="event-festival-banner">
      <p>Questo evento fa parte del <strong><a href="/eventi/puglian-italian-fest">Puglian Italian Fest</a></strong></p>
      <p class="event-festival-dates">
        {new Date(festival.date).toLocaleDateString('it-IT', { day: 'numeric', month: 'long' })} - {new Date(festival.endDate).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })} | {festival.location}
      </p>
    </div>

  </div>

  <script>
    // Booking modal logic
    const bookingBtn = document.querySelector('.booking-btn') as HTMLAnchorElement;
    const modal = document.getElementById('bookingModal');
    const modalClose = document.getElementById('bookingModalClose');
    const bookingForm = document.getElementById('bookingForm') as HTMLFormElement;
    let bookingUrl = '';

    if (bookingBtn && modal) {
      bookingUrl = bookingBtn.dataset.bookingUrl || bookingBtn.href;

      if (bookingUrl && !bookingUrl.startsWith('mailto:')) {
        bookingBtn.addEventListener('click', (e) => {
          e.preventDefault();
          modal.classList.add('active');
        });
      }

      modalClose?.addEventListener('click', () => {
        modal.classList.remove('active');
      });

      bookingForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fname = (bookingForm.querySelector('[name="FNAME"]') as HTMLInputElement).value;
        const lname = (bookingForm.querySelector('[name="LNAME"]') as HTMLInputElement).value;
        const email = (bookingForm.querySelector('[name="EMAIL"]') as HTMLInputElement).value;
        modal.classList.remove('active');
        window.open(bookingUrl, '_blank');
        fetch('/api/newsletter-subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fname, lname, email, lang: 'it' }),
        }).catch(() => {});
      });
    }

    const icsBtn = document.getElementById('ics-download');
    if (icsBtn) {
      icsBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const el = e.currentTarget as HTMLElement;
        const title = el.dataset.title || '';
        const dtStart = el.dataset.date || '';
        const dtEnd = el.dataset.end || '';
        const location = el.dataset.location || '';
        const description = el.dataset.description || '';
        const ics = [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//Pugliesi nel Mondo UK//EN',
          'BEGIN:VEVENT',
          `DTSTART:${dtStart}`,
          `DTEND:${dtEnd}`,
          `SUMMARY:${title}`,
          `LOCATION:${location}`,
          `DESCRIPTION:${description}`,
          'END:VEVENT',
          'END:VCALENDAR'
        ].join('\r\n');
        const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${title.replace(/[^a-zA-Z0-9]/g, '-')}.ics`;
        a.click();
        URL.revokeObjectURL(url);
      });
    }

    // Member note modal
    const memberNoteBtn = document.getElementById('memberNoteBtn');
    const memberModal = document.getElementById('memberModal');
    const memberModalClose = document.getElementById('memberModalClose');
    if (memberNoteBtn && memberModal) {
      memberNoteBtn.addEventListener('click', () => memberModal.classList.add('active'));
      memberModalClose?.addEventListener('click', () => memberModal.classList.remove('active'));
      memberModal.addEventListener('click', (e) => {
        if (e.target === memberModal) memberModal.classList.remove('active');
      });
    }
  </script>
</BaseLayout>
