---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const festivalPath = path.join(process.cwd(), 'src/content/events/puglian-italian-fest.json');
  const festival = JSON.parse(fs.readFileSync(festivalPath, 'utf-8'));
  return festival.programme.map((item: any) => ({
    params: { event: item.slug },
    props: { item, festival }
  }));
}

const { item, festival } = Astro.props;
const isPast = festival.status === 'past';

// Calendar URLs (only computed for upcoming events)
const startDate = item.date.replace(/-/g, '');
const startTime = item.time && item.time !== 'TBA' && !item.time.includes('TBC')
  ? item.time.split(' - ')[0].replace(':', '') + '00'
  : '180000';
const endTime = item.time && item.time.includes(' - ')
  ? item.time.split(' - ')[1].replace(':', '') + '00'
  : String(Number(startTime.slice(0, 2)) + 2).padStart(2, '0') + startTime.slice(2);
const calStart = `${startDate}T${startTime}`;
const calEnd = `${startDate}T${endTime}`;
const calTitle = encodeURIComponent(item.title);
const calLocation = encodeURIComponent(`${item.venue}${item.address ? ', ' + item.address : ''}`);
const calDescription = encodeURIComponent(`${item.description}\n\nPuglian Italian Fest - pugliesinelmondouk.vercel.app`);

const googleCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${calTitle}&dates=${calStart}/${calEnd}&location=${calLocation}&details=${calDescription}`;
const outlookUrl = `https://outlook.live.com/calendar/0/action/compose?subject=${calTitle}&startdt=${item.date}T${startTime.slice(0,4)}&location=${calLocation}&body=${calDescription}`;
---

<BaseLayout title={`${item.title} | Puglian Italian Fest`} currentPath={`/eventi/puglian-italian-fest/${item.slug}`}>
  <div class="event-detail">
    <a href="/eventi" style="color: var(--color-primary); display: inline-block; margin-bottom: 2rem;">&larr; Torna agli Eventi</a>

    <div class="event-hero">
      {item.image ? <img src={item.image} alt={item.title} /> : <div class="event-hero-placeholder"></div>}
    </div>

    <h1>{item.title}</h1>
    {item.category && <span class="event-category-badge">{item.category}</span>}

    <div class="event-info-block">
      <div class="event-info-row">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
        <div>
          <strong>Quando</strong>
          <p>{new Date(item.date).toLocaleDateString('it-IT', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}{item.time && item.time !== 'TBA' ? `, ${item.time}` : ''}</p>
        </div>
      </div>
      <div class="event-info-row">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" /></svg>
        <div>
          <strong>Dove</strong>
          <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.venue + (item.address ? ', ' + item.address : ''))}`} target="_blank" rel="noopener" class="event-venue-link">{item.venue}</a>
          {item.address && <p class="event-address"><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.venue + ', ' + item.address)}`} target="_blank" rel="noopener" class="event-venue-link">{item.address}</a></p>}
        </div>
      </div>
      {!isPast && item.price && (
        <div class="event-info-row">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5"><text x="4" y="20" font-size="20" font-weight="bold" fill="var(--color-primary)" stroke="none">£</text></svg>
          <div>
            <strong>Prezzo</strong>
            <p>{item.price}</p>
          </div>
        </div>
      )}
    </div>

    <div class="event-description">
      {isPast && item.pastDescription ? (
        <p>{item.pastDescription}</p>
      ) : (
        <>
          {item.longDescription && item.longDescription.map((p: string) => <p>{p}</p>)}
          {!item.longDescription && <p>{item.description}</p>}
        </>
      )}
    </div>

    {!isPast && (
      <>
        <!-- Booking -->
        <div class="event-booking">
          {item.bookingLink && (
            <a href={item.bookingLink} class="btn-primary booking-btn" data-booking-url={item.bookingLink}>
              Prenota Ora
            </a>
          )}
          {item.memberNote && (
            <button class="btn-member-free" id="memberNoteBtn">
              Gratis per i Soci
            </button>
          )}
        </div>

        {/* Member Note Modal */}
        {item.memberNote && (
          <div class="member-modal-overlay" id="memberModal">
            <div class="member-modal">
              <button class="member-modal-close" id="memberModalClose">&times;</button>
              <h3>🎟️ Ingresso gratuito per i Soci</h3>
              <p>{item.memberNote}</p>
              <div style="text-align:center; margin-top:1rem;">
                <a href={`mailto:info@pugliesinelmondouk.org?subject=${encodeURIComponent('Prenotazione posto gratuito – ' + item.title + ' – ' + new Date(item.date).toLocaleDateString('it-IT', {day:'numeric', month:'long', year:'numeric'}))}&body=${encodeURIComponent('Salve,\n\nVorrei prenotare un posto gratuito per l\'evento ' + item.title + ' del ' + new Date(item.date).toLocaleDateString('it-IT', {day:'numeric', month:'long', year:'numeric'}) + ', ore ' + item.time + ', presso ' + item.venue + ', ' + item.address + '.\n\nSono socio di Pugliesi nel Mondo UK e presenterò la mia tessera all\'ingresso.\n\nNome e Cognome:\nNumero tessera:\n\nGrazie,')}`} class="btn-primary" style="font-size:0.9rem;">Prenota il tuo posto gratuito per email</a>
              </div>
            </div>
          </div>
        )}

        {/* Booking Modal */}
        <div class="booking-modal-overlay" id="bookingModal">
          <div class="booking-modal">
            <button class="booking-modal-close" id="bookingModalClose">&times;</button>
            <h3>Resta aggiornato</h3>
            <p class="booking-modal-desc">Lasciaci i tuoi dati per ricevere aggiornamenti su questo evento e sulle nostre attivita'. Saremo molto discreti: solo comunicazioni utili, niente spam. Potrai disiscriverti in qualsiasi momento con un solo click.</p>
            <form class="booking-modal-form" id="bookingForm">
              <input type="text" name="FNAME" placeholder="Nome" required />
              <input type="text" name="LNAME" placeholder="Cognome" required />
              <input type="email" name="EMAIL" placeholder="Email" required />
              <button type="submit" class="btn-primary" style="width: 100%;">Continua con la prenotazione</button>
            </form>
            <div style="text-align:center; margin-top:1rem;">
              <button id="skipSubscribeBtn" style="background:none; border:none; color: var(--color-primary); text-decoration:underline; cursor:pointer; font-size:0.9rem;">Continua senza iscriverti</button>
            </div>
          </div>
        </div>

        {/* Add to Calendar */}
        <div class="event-calendar">
          <h3>Aggiungi al Calendario</h3>
          <div class="calendar-buttons">
            <a href={googleCalUrl} target="_blank" rel="noopener" class="calendar-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
              Google Calendar
            </a>
            <a href={outlookUrl} target="_blank" rel="noopener" class="calendar-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
              Outlook
            </a>
            <a href="#" class="calendar-btn" id="ics-download" data-title={item.title} data-date={calStart} data-end={calEnd} data-location={`${item.venue}${item.address ? ', ' + item.address : ''}`} data-description={item.description}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
              Scarica .ics
            </a>
          </div>
        </div>
      </>
    )}

    {isPast && (
      <div class="event-gallery-section">
        <h3>Galleria</h3>
        {item.gallery && (item.gallery.photos.length > 0 || item.gallery.videos.length > 0) ? (
          <>
            {item.gallery.photos.length > 0 && (
              <div class="gallery-grid">
                {item.gallery.photos.map((photo: any, i: number) => (
                  <a href={photo.url} class="gallery-photo" data-lightbox data-index={i}>
                    <img src={photo.url} alt={photo.caption || item.title} loading="lazy" />
                    {photo.caption && <span class="gallery-caption">{photo.caption}</span>}
                  </a>
                ))}
              </div>
            )}
            {item.gallery.videos.length > 0 && (
              <div class="gallery-videos">
                {item.gallery.videos.map((video: any) => (
                  <div class="gallery-video">
                    <div class="video-embed">
                      <iframe
                        src={`https://www.youtube.com/embed/${video.url.includes('youtu.be/') ? video.url.split('youtu.be/')[1].split('?')[0] : video.url.includes('watch?v=') ? video.url.split('watch?v=')[1].split('&')[0] : video.url}`}
                        title={video.title || 'Video'}
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                      ></iframe>
                    </div>
                    {video.title && <p class="video-title">{video.title}</p>}
                  </div>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="event-gallery-placeholder-grid">
            <div class="event-gallery-placeholder-item">📷 Foto in arrivo</div>
            <div class="event-gallery-placeholder-item">📷 Foto in arrivo</div>
            <div class="event-gallery-placeholder-item">🎥 Video in arrivo</div>
          </div>
        )}
      </div>
    )}

    <div class="event-festival-banner">
      {isPast ? (
        <p>Questo evento ha fatto parte del <strong><a href="/eventi">Puglian Italian Fest</a></strong></p>
      ) : (
        <p>Questo evento fa parte del <strong><a href="/eventi/puglian-italian-fest">Puglian Italian Fest</a></strong></p>
      )}
      <p class="event-festival-dates">
        {new Date(festival.date).toLocaleDateString('it-IT', { day: 'numeric', month: 'long' })} - {new Date(festival.endDate).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })} | {festival.location}
      </p>
    </div>

  </div>

  {!isPast && (
    <script>
      const bookingBtn = document.querySelector('.booking-btn') as HTMLAnchorElement;
      const modal = document.getElementById('bookingModal');
      const modalClose = document.getElementById('bookingModalClose');
      const bookingForm = document.getElementById('bookingForm') as HTMLFormElement;
      let bookingUrl = '';

      if (bookingBtn && modal) {
        bookingUrl = bookingBtn.dataset.bookingUrl || bookingBtn.href;

        if (bookingUrl && !bookingUrl.startsWith('mailto:')) {
          bookingBtn.addEventListener('click', (e) => {
            e.preventDefault();
            modal.classList.add('active');
          });
        }

        modalClose?.addEventListener('click', () => {
          modal.classList.remove('active');
        });

        modal.addEventListener('click', (e) => {
          if (e.target === modal) modal.classList.remove('active');
        });

        bookingForm?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const fname = (bookingForm.querySelector('[name="FNAME"]') as HTMLInputElement).value;
          const lname = (bookingForm.querySelector('[name="LNAME"]') as HTMLInputElement).value;
          const email = (bookingForm.querySelector('[name="EMAIL"]') as HTMLInputElement).value;
          modal.classList.remove('active');
          window.open(bookingUrl, '_blank');
          fetch('/api/newsletter-subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fname, lname, email, lang: 'it' }),
          }).catch(() => {});
        });

        const skipBtn = document.getElementById('skipSubscribeBtn');
        skipBtn?.addEventListener('click', () => {
          modal.classList.remove('active');
          window.open(bookingUrl, '_blank');
        });
      }

      const icsBtn = document.getElementById('ics-download');
      if (icsBtn) {
        icsBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const el = e.currentTarget as HTMLElement;
          const title = el.dataset.title || '';
          const dtStart = el.dataset.date || '';
          const dtEnd = el.dataset.end || '';
          const location = el.dataset.location || '';
          const description = el.dataset.description || '';
          const ics = [
            'BEGIN:VCALENDAR',
            'VERSION:2.0',
            'PRODID:-//Pugliesi nel Mondo UK//EN',
            'BEGIN:VEVENT',
            `DTSTART:${dtStart}`,
            `DTEND:${dtEnd}`,
            `SUMMARY:${title}`,
            `LOCATION:${location}`,
            `DESCRIPTION:${description}`,
            'END:VEVENT',
            'END:VCALENDAR'
          ].join('\r\n');
          const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `${title.replace(/[^a-zA-Z0-9]/g, '-')}.ics`;
          a.click();
          URL.revokeObjectURL(url);
        });
      }

      const memberNoteBtn = document.getElementById('memberNoteBtn');
      const memberModal = document.getElementById('memberModal');
      const memberModalClose = document.getElementById('memberModalClose');
      if (memberNoteBtn && memberModal) {
        memberNoteBtn.addEventListener('click', () => memberModal.classList.add('active'));
        memberModalClose?.addEventListener('click', () => memberModal.classList.remove('active'));
        memberModal.addEventListener('click', (e) => {
          if (e.target === memberModal) memberModal.classList.remove('active');
        });
      }
    </script>
  )}
</BaseLayout>

<style>
  .event-gallery-section {
    margin: 2.5rem 0;
  }
  .event-gallery-section h3 {
    font-family: var(--font-heading);
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .event-gallery-placeholder-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .event-gallery-placeholder-item {
    height: 120px;
    background: #f0ede5;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    color: #b0a998;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .gallery-photo {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    display: block;
    aspect-ratio: 4/3;
  }
  .gallery-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .gallery-photo:hover img {
    transform: scale(1.05);
  }
  .gallery-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.7));
    color: white;
    font-size: 0.8rem;
    padding: 1.5rem 0.75rem 0.5rem;
  }
  .gallery-videos {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .video-embed {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    border-radius: 8px;
    overflow: hidden;
  }
  .video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-title {
    font-size: 0.9rem;
    color: var(--color-gray);
    margin-top: 0.5rem;
    font-style: italic;
  }
  /* Lightbox */
  .lightbox-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.9);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .lightbox-overlay.active {
    opacity: 1;
    pointer-events: all;
  }
  .lightbox-overlay img {
    max-width: 90vw;
    max-height: 85vh;
    border-radius: 4px;
    object-fit: contain;
  }
  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    color: white;
    font-size: 2.5rem;
    background: none;
    border: none;
    cursor: pointer;
    line-height: 1;
  }
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: white;
    font-size: 2.5rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 1rem;
  }
  .lightbox-prev { left: 0.5rem; }
  .lightbox-next { right: 0.5rem; }
  .lightbox-caption {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    color: white;
    font-size: 0.9rem;
    background: rgba(0,0,0,0.5);
    padding: 0.4rem 1rem;
    border-radius: 4px;
    max-width: 80vw;
    text-align: center;
  }
  @media (max-width: 600px) {
    .event-gallery-placeholder-grid,
    .gallery-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  // Lightbox
  const photos = document.querySelectorAll('[data-lightbox]');
  if (photos.length > 0) {
    const overlay = document.createElement('div');
    overlay.className = 'lightbox-overlay';
    overlay.innerHTML = `
      <button class="lightbox-close">&times;</button>
      <button class="lightbox-nav lightbox-prev">&lsaquo;</button>
      <button class="lightbox-nav lightbox-next">&rsaquo;</button>
      <img src="" alt="" />
      <div class="lightbox-caption"></div>
    `;
    document.body.appendChild(overlay);

    const img = overlay.querySelector('img') as HTMLImageElement;
    const caption = overlay.querySelector('.lightbox-caption') as HTMLElement;
    let current = 0;
    const items = Array.from(photos) as HTMLElement[];

    function show(index: number) {
      current = (index + items.length) % items.length;
      const el = items[current];
      const photo = el.querySelector('img') as HTMLImageElement;
      const cap = el.querySelector('.gallery-caption');
      img.src = photo.src;
      img.alt = photo.alt;
      caption.textContent = cap ? cap.textContent || '' : '';
      caption.style.display = cap ? 'block' : 'none';
    }

    photos.forEach((el, i) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        overlay.classList.add('active');
      });
    });

    overlay.querySelector('.lightbox-close')!.addEventListener('click', () => overlay.classList.remove('active'));
    overlay.querySelector('.lightbox-prev')!.addEventListener('click', () => show(current - 1));
    overlay.querySelector('.lightbox-next')!.addEventListener('click', () => show(current + 1));
    overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('active'); });
    document.addEventListener('keydown', (e) => {
      if (!overlay.classList.contains('active')) return;
      if (e.key === 'Escape') overlay.classList.remove('active');
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  }
</script>
